yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

# keep reloads idempotent: clear existing rules before re-adding them
while yabai -m rule --remove 0 >/dev/null 2>&1; do :; done

# default layout (can be bsp, stack or float)
yabai -m config layout bsp

# new window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child

# padding set to 12px
yabai -m config top_padding 20
yabai -m config bottom_padding 6
yabai -m config left_padding 6
yabai -m config right_padding 6
yabai -m config window_gap 6

yabai -m config window_shadow off

# -- mouse settings --

# center mouse on window with focus
# yabai -m config mouse_follows_focus on

# modifier for clicking and dragging with mouse
yabai -m config mouse_modifier alt
# set modifier + left-click drag to move window
yabai -m config mouse_action1 move
# set modifier + right-click drag to resize window
yabai -m config mouse_action2 resize

# window_border_radius is not supported by the installed yabai version.

# when window is dropped in center of another window, swap them (on edges it will split it)
yabai -m config mouse_drop_action swap

yabai -m config window_shadow float

yabai -m config external_bar all:36:0

# floating/overlay windows (e.g. browser PiP) — don't manage or warp mouse
yabai -m rule --add title="^Picture in Picture$" manage=off mouse_follows_focus=off

# disable specific apps
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Messages$" manage=off 
yabai -m rule --add app="^Calculator$" manage=off 
yabai -m rule --add app="^1Password$" manage=off 
yabai -m rule --add app="^CleanShotX$" manage=off 
yabai -m rule --add app="^CleanShot X$" manage=off 

yabai -m rule --add app="^Ghostty$" space=1
yabai -m rule --add app="^Obsidian$" space=3
yabai -m rule --add app="^Todoist$" space=3
yabai -m rule --add app="^UnrealEditor$" space=3
# yabai -m rule --add app="^DataGrip$" space=4
yabai -m rule --add app="^Slack$" space=5
yabai -m rule --add app="^(Zoom|zoom\.us)$" subrole="^AXStandardWindow$" space=8
yabai -m rule --add app="^Granola$" space=8
yabai -m rule --add app="^Char$" space=8
yabai -m rule --add app="^Fantastical$" space=6
yabai -m rule --add app="^Youtube Music$" space=9

borders active_color=0xffeb6f92 inactive_color=0xff6e738d width=4.0 &


