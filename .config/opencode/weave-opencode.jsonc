{
  "$schema": "https://raw.githubusercontent.com/pgermishuys/opencode-weave/main/schema/weave-config.schema.json",
  "continuation": {
    "recovery": {
      "compaction": true
    },
    "idle": {
      "enabled": true
    }
  },
  "agents": {
    "loom": {
      "model": "openai/gpt-5.6-terra",
      "temperature": 0.1,
      "skills": [
        "feature-brainstorm"
      ]
    },
    "tapestry": {
      "temperature": 0.0,
      "model": "openai/gpt-5.6-sol",
      "modelOptions": {
        // Anthropic Messages API options; retained for reference only.
        // "thinking": {
        //   "type": "adaptive"
        // },
        // "output_config": {
        //   "effort": "xhigh"
        // },
        "reasoningEffort": "xhigh"
      },
      "prompt_append": "After completing each task create a commit using conventional commits",
      "skills": [
        "tdd",
        "typescript-advanced-types",
        "animate",
        "vercel-composition-patterns"
      ],
      "tools": {
        "task": true,
        "call_weave_agent": true
      }
    },
    "shuttle": {
      "model": "openai/gpt-5.6-luna",
      "skills": [
        "typescript-advanced-types",
        "vercel-composition-patterns"
      ],
      "prompt_append": "Load the tdd skill"
    },
    "pattern": {
      "model": "openai/gpt-5.6-sol",
      "modelOptions": {
        // Anthropic Messages API options; retained for reference only.
        // "thinking": {
        //   "type": "adaptive"
        // },
        // "output_config": {
        //   "effort": "xhigh"
        // },
        "reasoningEffort": "xhigh"
      },
    },
    "thread": {
      "model": "openai/gpt-5.6-luna",
    },
    "spindle": {
      "model": "openai/gpt-5.6-luna",
      "prompt_append": "Use context7 to search documentation on libraries, or frameworks. Use grep mcp to search code samples in github."
    },
    "weft": {
      "model": "openai/gpt-5.6-sol",
      "modelOptions": {
        // Anthropic Messages API options; retained for reference only.
        // "thinking": {
        //   "type": "adaptive"
        // },
        // "output_config": {
        //   "effort": "xhigh"
        // },
        "reasoningEffort": "xhigh"
      },
      "prompt_append": "Load the skill @thermonuclear-code-quality-review"
    },
    "warp": {
      "model": "openai/gpt-5.6-sol",
      "modelOptions": {
        // Anthropic Messages API options; retained for reference only.
        // "thinking": {
        //   "type": "adaptive"
        // },
        // "output_config": {
        //   "effort": "xhigh"
        // },
        "reasoningEffort": "xhigh"
      },
    },
    "custom_agents": {
      "sentinel": {
        "prompt_file": ".opencode/prompts/browser-tester.md",
        "model": "openai/gpt-5.6-terra",
        "modelOptions": {
          "reasoningEffort": "high"
        },
        "mode": "all",
        "display_name": "Sentinel (QA Agent)",
        "description": "An autonomous agent designed for testing of web applications. Sentinel simulates user interactions, identifies potential issues, and provides detailed feedback to improve the quality and usability of the application.",
        "temperature": 0.2,
        "top_p": 0.9,
        "skills": [
          "agent-browser",
          "dogfood"
        ],
        "triggers": [
          {
            "domain": "Web",
            "trigger": "Run exploratory testing and surface any issues"
          }
        ]
      }
    },
    "categories": {
      "mini": {
        "description": "Use for fast, cost-efficient coding tasks in a known codebase when the requirements are clear and the change is mostly mechanical or localized. Prefer this agent for straightforward feature work, small bug fixes, boilerplate, CRUD flows, test updates, type fixes, simple refactors, implementation from an already-approved plan, and repetitive edits where speed and throughput matter.",
        "model": "xai/grok-composer-2.5-fast",
        "prompt_append": "Load the tdd skill"
      },
      "frontend": {
        "description": "Specializes in crafting exceptional user interfaces and frontend experiences. Owns everything users see and interact with, including component architecture, responsive layouts, accessibility, visual polish, animations, performance, design system consistency, and developer ergonomics. Breaks complex interfaces into reusable components, follows existing design language, minimizes unnecessary re-renders, and prioritizes usability and maintainability. Choose this agent whenever the majority of the implementation involves UI, styling, component composition, client-side behavior, or frontend performance. Do not use for backend logic, infrastructure, data modeling, or server-side architecture unless those changes are incidental to the frontend implementation.",
        "model": "anthropic/claude-opus-4-6",
        "temperature": 0.4,
        "prompt_append": "Preserve design consistency. Reuse shared components. Match existing button, input, spacing, and typography patterns."
      }
    }
  }
}
