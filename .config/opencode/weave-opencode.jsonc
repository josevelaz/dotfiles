{
  "$schema": "https://raw.githubusercontent.com/pgermishuys/opencode-weave/main/schema/weave-config.schema.json",
  "continuation": {
    "recovery": {
      "compaction": true
    },
    "idle": {
      "enabled": true
    }
  },
  "agents": {
    "loom": {
      "model": "openai/gpt-5.4",
      "modelOptions": {
        "reasoningEffort": "medium"
      },
      "fallback_models": [
        "github-copilot/gpt-5.4"
      ],
      "temperature": 0.1,
      "skills": [
        "feature-brainstorm"
      ]
    },
    "tapestry": {
      "temperature": 0.0,
      "model": "openai/gpt-5.5",
      "modelOptions": {
        "reasoningEffort": "high"
      },
      "fallback_models": [
        "github-copilot/gpt-5.4"
      ],
      "skills": [
        "tdd",
        "typescript-advanced-types",
        "animate",
        "vercel-composition-patterns"
      ],
      "tools": {
        "task": true,
        "call_weave_agent": true
      }
    },
    "shuttle": {
      "model": "openai/gpt-5.4",
      "skills": [
        "typescript-advanced-types",
        "animate",
        "vercel-composition-patterns"
      ]
    },
    "pattern": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_models": [
        "github-copilot/gpt-5.4"
      ]
    },
    "thread": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        "github-copilot/claude-sonnet-4.6"
      ]
    },
    "spindle": {
      "model": "openai/gpt-5.4-mini-fast",
      "fallback_models": [
        "github-copilot/gpt-5.4"
      ],
      "prompt_append": "Use context7 to search documentation on libraries, or frameworks. Use grep mcp to search code samples in github."
    },
    "weft": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_models": [
        "github-copilot/gpt-5.5"
      ],
      "modelOptions": {
        "reasoningEffort": "xhigh"
      },
      "prompt_append": "Load the skill @thermonuclear-code-quality-review"
    },
    "warp": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_models": [
        "openai/gpt-5.5"
      ],
      "modelOptions": {
        "reasoningEffort": "xhigh"
      },
    }
  },
  "custom_agents": {
    "sentinel": {
      "prompt_file": ".opencode/prompts/browser-tester.md",
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "github-copilot/gpt-5.5"
      ],
      "modelOptions": {
        "reasoningEffort": "high"
      },
      "mode": "all",
      "display_name": "Sentinel (QA Agent)",
      "description": "An autonomous agent designed for testing of web applications. Sentinel simulates user interactions, identifies potential issues, and provides detailed feedback to improve the quality and usability of the application.",
      "temperature": 0.2,
      "top_p": 0.9,
      "skills": [
        "agent-browser",
        "dogfood"
      ],
      "triggers": [
        {
          "domain": "Web",
          "trigger": "Run exploratory testing and surface any issues"
        }
      ]
    }
  },
  "categories": {
    "frontend": {
      "description": "Any work that involves, UI, UX and design.",
      "model": "anthropic/claude-opus-4-8",
      "fallback_models": [
        "github-copilot/claude-opus-4.6"
      ],
      "temperature": 0.4,
      "prompt_append": "Preserve design consistency. Reuse shared components. Match existing button, input, spacing, and typography patterns."
    }
  }
}
