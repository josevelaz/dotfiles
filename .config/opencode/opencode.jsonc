{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "lsp": "allow",
    "read": {
      "~/obsidian_vaults/notes/*": "allow",
      "~/.agent-browser/tmp/screenshots/*": "allow",
      "~/*": "ask"
    },
    "edit": {
      "~/*": "deny",
    },
    "external_directory": {
      "/tmp/*": "allow",
    },
  },
  "plugin": [
    "@opencode_weave/weave@0.7.6-preview.2",
    "@tarquinen/opencode-dcp@beta",
    "@mohak34/opencode-notifier@latest",
    "@franlol/opencode-md-table-formatter@latest",
    // Local workstation-only plugins — add these back in a machine-local override
    // if needed. See .config/opencode/opencode.local.example.jsonc for instructions.
  ],
  "mcp": {
    "strapi-mcp": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "strapi-mcp"
      ],
      "environment": {
        "STRAPI_URL": "https://strapi-production-a933.up.railway.app",
        "STRAPI_ADMIN_EMAIL": "{env:STRAPI_ADMIN_EMAIL}",
        "STRAPI_ADMIN_PASSWORD": "{env:STRAPI_ADMIN_PASSWORD}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "vibma": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ufira/vibma@latest",
        "--edit"
      ]
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "reactotron": {
      "enabled": false,
      "type": "remote",
      "url": "http://localhost:4567/mcp"
    },
    "linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "railway": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "graphql@16",
        "-p",
        "@railway/mcp-server",
        "railway-mcp-server"
      ]
    }
  },
  "provider": {
    "openai": {
      "name": "OpenAI",
      "options": {
        // "baseURL": "http://127.0.0.1:2455/v1",
        // "apiKey": "{env:CODEX_LB_API_KEY}",
        "timeout": 1200000,
        "chunkTimeout": 600000
      },
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed",
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed"
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
        },
      }
    }
  }
}
