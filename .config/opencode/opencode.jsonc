{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-devcontainers"
  ],
  "autoupdate": true,
  "lsp": {
    "go": {
      "command": [
        "gopls"
      ],
      "extensions": [
        "go",
        "templ",
        "gomod",
        "gowork"
      ]
    },
    "templ": {
      "command": [
        "go",
        "tool",
        "templ",
        "lsp"
      ],
      "extensions": [
        "templ"
      ]
    },
    "htmx": {
      "command": [
        "htmx-lsp"
      ],
      "extensions": [
        "templ",
        "html"
      ]
    }
  },
  "mcp": {
    "obsidian": {
      "type": "remote",
      "url": "http://localhost:27122/mcp",
      "headers": {
        "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "vibma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ufira/vibma",
        "--edit"
      ]
    },
    "figma": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {}
    },
    "figma_desktop": {
      "enabled": false,
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
    }
  },
  "provider": {
    "bailian-coding-plan": {
      "npm": "@ai-sdk/anthropic",
      "name": "Model Studio Coding Plan",
      "options": {
        "baseURL": "https://coding-intl.dashscope.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:ALIBABA_STUDIO_API_KEY}"
      },
      "models": {
        "qwen3.5-plus": {
          "name": "Qwen3.5 Plus",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "qwen3-max-2026-01-23": {
          "name": "Qwen3 Max 2026-01-23"
        },
        "qwen3-coder-next": {
          "name": "Qwen3 Coder Next"
        },
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus"
        },
        "MiniMax-M2.5": {
          "name": "MiniMax M2.5",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "glm-5": {
          "name": "GLM-5",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "glm-4.7": {
          "name": "GLM-4.7",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192
            }
          }
        }
      }
    }
  },
  "permission": {
    "task": "deny"
  }
}
