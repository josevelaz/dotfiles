{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "small_model": "openai/gpt-5.4-mini",
  "permission": {
    "lsp": "allow",
    "read": {
      "~/obsidian_vaults/notes/*": "allow",
      "~/.agent-browser/tmp/screenshots/*": "allow",
      "/Users/josevelazquez/*": "ask"
    },
    "edit": {
      "/Users/josevelazquez/*": "deny",
    },
    "external_directory": {
      "/tmp/*": "allow",
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@mohak34/opencode-notifier@latest",
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "vibma": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ufira/vibma@latest",
        "--edit"
      ]
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "provider": {
    "openai": {
      "name": "OpenAI | LoadBalanced",
      "options": {
        "baseURL": "http://127.0.0.1:2455/v1",
        "apiKey": "{env:CODEX_LB_API_KEY}",
        "timeout": 1200000,
        "chunkTimeout": 600000
      },
      "models": {
        "gpt-5.4": {
          "name": "GPT-5.4",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed",
            "serviceTier": "priority",
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "reasoning": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "detailed"
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
        },
        "gpt-5.3-codex-spark": {
          "name": "GPT-5.3 Codex Spark",
          "reasoning": true,
          "options": {
            "reasoningEffort": "xhigh",
            "reasoningSummary": "detailed"
          },
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    }
  }
}
