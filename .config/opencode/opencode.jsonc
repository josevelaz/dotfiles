{
  "$schema": "https://opencode.ai/config.json",
  "warming": true,
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "scout": {
      "disabled": true
    }
  },
  "instructions": [
    "DESIGN.md"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "type": "remote",
        "oauth": false,
        "url": "https://mcp.context7.com/mcp"
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "conflux": {
        "type": "remote",
        "url": "https://conflux.liatr.io/mcp"
      },
    },
  },
  // "permission": {
  //   "aft_*": "allow",
  //   "external_directory": {
  //     "/Users/jose/dotfiles/.local/share/cortexkit/**": "allow",
  //     "/Users/jose/dotfiles/.local/share/opencode/worktree/**": "allow",
  //     "/dev/**": "allow",
  //     "/tmp/**": "allow",
  //     "~/.local/share/opencode/self-improve/**": "ask"
  //   },
  //   "glob": "allow",
  //   "grep": "allow",
  //   "list": "allow",
  //   "lsp": "allow",
  //   "question": "allow",
  //   "read": "allow",
  //   "skill_manage": "allow",
  //   "skill_pending_apply": "ask",
  //   "skill_pending_diff": "allow",
  //   "skill_pending_list": "allow",
  //   "skill_pending_reject": "allow",
  //   "~": "ask"
  // },
  "plugins": [
    "/Users/jose/projects/opencode-honcho",
    "-opencode.provider.github.copilot",
  ],
  "providers": {
    "github-copilot": {
      "env": ["OPENCODE_GITHUB_COPILOT"],
    },
    "xai": {
      "models": {
        "grok-4.6-fast": {
          "modelID": "grok-4.6",
          "name": "Grok 4.6 Fast",
          "settings": {
            "serviceTier": "priority",
          },
          "body": {
            "service_tier": "priority",
          },
          "capabilities": {
            "tools": true,
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "limit": {
            "context": 500000,
            "output": 500000,
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
              },
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
              },
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
              },
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
              },
            },
          ],
        },
      },
    },
  },
}
