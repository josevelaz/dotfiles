{
  "$schema": "https://opencode.ai/config.json",
  "warming": true,
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "scout": {
      "disabled": true
    }
  },
  "instructions": [
    "DESIGN.md"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "type": "remote",
        "oauth": false,
        "url": "https://mcp.context7.com/mcp"
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      }
    }
  },
  "providers": {
    "muse-subscription": {
      "name": "Muse Subscription",
      "package": "@opencode/ai/providers/meta/responses",
      "settings": {
        "baseURL": "https://api.meta.ai/v1"
      },
      "headers": {
        "x-api-version": "1.0.0",
        "x-client-id": "tbh:exec"
      },
      "body": {
        "store": false
      },
      "models": {
        "muse-spark-1.3": {
          "name": "Muse Spark 1.3 (Subscription)",
          "family": "muse",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image",
              "pdf",
              "video",
              "audio"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 0,
            "output": 0,
            "cache": {
              "read": 0,
              "write": 0
            }
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "variants": [
            {
              "id": "minimal",
              "settings": {
                "reasoningEffort": "minimal",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max",
                "reasoningSummary": "auto",
                "include": [
                  "reasoning.encrypted_content"
                ]
              }
            }
          ]
        },
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor (Subscription)",
          "family": "muse",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
