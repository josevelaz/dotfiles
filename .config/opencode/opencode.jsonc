  //     "/Users/jose/dotfiles/.local/share/opencode/worktree/**": "allow",
  //     "/dev/**": "allow",
  //     "/tmp/**": "allow",
  //     "~/.local/share/opencode/self-improve/**": "ask"
  //   },
  //   "glob": "allow",
  //   "grep": "allow",
  //   "list": "allow",
  //   "lsp": "allow",
  //   "question": "allow",
  //   "read": "allow",
  //   "skill_manage": "allow",
  //   "skill_pending_apply": "ask",
  //   "skill_pending_diff": "allow",
  //   "skill_pending_list": "allow",
  //   "skill_pending_reject": "allow",
  //   "~": "ask"
  // },
  "plugins": [
    "./plugins/goal/index.ts",
    "/Users/jose/projects/opencode-claude-code-auth/src/index.ts",
    "@franlol/opencode-md-table-formatter@latest",
    "@cortexkit/aft-opencode@latest",
    "@honcho-ai/opencode-honcho",
  ],
}
