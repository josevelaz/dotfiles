{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "DESIGN.md"
  ],
  "permission": {
    "question": "allow",
    "lsp": "allow",
    "read": "allow",
    "aft_*": "allow",
    "edit": {
      "~/*": "deny"
    },
    "external_directory": {
      "/tmp/*": "allow",
      "/dev/*": "allow",
      "~/.local/share/cortexkit/aft/opencode/bash-tasks": "allow",
      "~/dotfiles/.local/share/opencode/worktree": "allow"
    }
  },
  "provider": {
    "xai": {
      "models": {
        "grok-composer-2.5-fast": {
          "name": "Composer 2.5 Fast"
        },
        "grok-build-0.1": {
          "name": "Grok Build"
        }
      }
    },
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:17321",
        "apiKey": "{env:CODEX_LB_KEY}",
        "headers": {
          "sleeve-provider": "codex",
          "sleeve-harness": "opencode"
        }
      }
    },
    "anthropic": {
      "options": {
        "headers": {
          "sleeve-provider": "anthropic",
          "sleeve-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    },
    "opencode": {
      "options": {
        "headers": {
          "sleeve-provider": "opencode",
          "sleeve-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    }
  },
  "plugin": [
    "@ex-machina/opencode-anthropic-auth",
    "@opencode_weave/weave",
    "@franlol/opencode-md-table-formatter@latest",
    "@cortexkit/aft-opencode@latest",
    "@honcho-ai/opencode-honcho"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "asana": {
      "type": "remote",
      "url": "https://mcp.asana.com/v2/mcp",
      "oauth": {
        "clientId": "1215734563644920",
        "clientSecret": "{env:ASANA_CLIENT_SECRET}"
      }
    },
  },
  "compaction": {
    "prune": false
  }
}
