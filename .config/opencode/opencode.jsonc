{
  "$schema": "https://opencode.ai/config.json",
  "warming": true,
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "scout": {
      "disabled": true
    }
  },
  "instructions": [
    "DESIGN.md"
  ],
  "mcp": {
    "servers": {
      "context7": {
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "type": "remote",
        "oauth": false,
        "url": "https://mcp.context7.com/mcp"
      },
      "grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
    },
  },
  // "permission": {
