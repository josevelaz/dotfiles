{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "autoupdate": true,
  "lsp": {
    "go": {
      "command": [ "gopls" ],
      "extensions": ["go", "templ", "gomod", "gowork"]
    },
    "templ": {
      "command": [ "go", "tool", "templ", "lsp" ],
      "extensions": ["templ"]
    },
    "htmx": {
      "command": [ "htmx-lsp" ],
      "extensions": ["templ", "html"]
    } 
  },
  "mcp": {
    "obsidian": {
      "type": "remote",
      "url": "http://localhost:27122/mcp",
      "headers": {
        "Authorization": "Bearer {env:OBSIDIAN_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
