{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "anthropic/claude-haiku-3-5-latest",
  "permission": {
    "question": "allow",
    "lsp": "allow",
    "read": {
      "~/obsidian_vaults/notes/*": "allow",
      "~/.agent-browser/tmp/screenshots/*": "allow",
      "~/*": "ask"
    },
    "edit": {
      "~/*": "deny"
    },
    "external_directory": {
      "/tmp/*": "allow"
    }
  },
  "plugin": [
    "opencode-claude-auth@latest",
    "@opencode_weave/weave",
    "opencode-mem",
    "@tarquinen/opencode-dcp@beta",
    "@mohak34/opencode-notifier@latest",
    "@franlol/opencode-md-table-formatter@latest",
    "@cortexkit/aft-opencode@latest"
  ],
  "mcp": {
    "resend": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "resend-mcp"
      ],
      "environment": {
        "RESEND_API_KEY": "{env:RESEND_API_KEY}"
      }
    },
    "strapi-mcp": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "strapi-mcp"
      ],
      "environment": {
        "STRAPI_URL": "https://strapi-production-a933.up.railway.app",
        "STRAPI_ADMIN_EMAIL": "{env:STRAPI_ADMIN_EMAIL}",
        "STRAPI_ADMIN_PASSWORD": "{env:STRAPI_ADMIN_PASSWORD}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "vibma": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@ufira/vibma@latest",
        "--edit"
      ]
    },
    "grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "reactotron": {
      "enabled": false,
      "type": "remote",
      "url": "http://localhost:4567/mcp"
    },
    "linear": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": {}
    },
    "railway": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "graphql@16",
        "-p",
        "@railway/mcp-server",
        "railway-mcp-server"
      ]
    }
  }
}
