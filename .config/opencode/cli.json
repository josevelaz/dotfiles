{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "orng"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "layout": "vertical"
  },
  "terminal": {
    "title": true
  },
  "attention": {
    "enabled": true
  },
  "prompt": {
    "editor": false
  }
}
