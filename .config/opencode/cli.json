{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "orng"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept",
    "grouping": "auto",
    "markdown": "rendered"
  },
  "animations": true,
  "tabs": {
    "enabled": false
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "copy": "select"
  }
}
