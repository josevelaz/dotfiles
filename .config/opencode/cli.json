{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "orng"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept",
    "image_preview": true
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "plugins": [
    "./herdr-opencode",
    {
      "package": "./project-notes",
      "options": {
        "vim": false
      }
    }
  ]
}
