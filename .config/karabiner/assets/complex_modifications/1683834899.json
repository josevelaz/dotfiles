{
    "title": "Caps Lock to ESC on tap/Left Control on hold - New",
    "rules": [
        {
            "description": "Caps Lock to ESC on tap/Left Alt on hold",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "caps_lock"
                    },
                    "to": [
                        {
                            "key_code": "left_control",
                            "lazy": true
                        }
                    ],
                    "to_if_alone": [
                        {
                            "key_code": "escape"
                        }
                    ]
                }
            ]
        }
    ]
}
