#!/usr/bin/env python3
"""Keep installed and custom agent skills in their canonical directories.

Skills installed through skills.sh live in .agents/skills and appear in
.agents/.skill-lock.json. Custom skills live in skills and are exposed through
relative symlinks in .agents/skills. A small set of those custom skills is also
linked into ~/.cursor/skills.
"""

from __future__ import annotations

import json
import os
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[2]
SKILLS_DIR = REPO_ROOT / "skills"
AGENTS_SKILLS_DIR = REPO_ROOT / ".agents" / "skills"
LOCK_PATH = REPO_ROOT / ".agents" / ".skill-lock.json"
CURSOR_SKILLS_DIR = Path.home() / ".cursor" / "skills"
CURSOR_SYNC_SKILLS = ("agents-md", "setup-project")


def path_exists(path: Path) -> bool:
    return path.exists() or path.is_symlink()


def expected_custom_target(name: str) -> Path:
    return Path("../../skills") / name


def link_custom_skill(name: str) -> bool:
    link_path = AGENTS_SKILLS_DIR / name
    expected_target = expected_custom_target(name)

    if link_path.is_symlink():
        if Path(os.readlink(link_path)) == expected_target:
            return False
        link_path.unlink()
    elif link_path.exists():
        raise RuntimeError(
            f"refusing to replace physical .agents/skills/{name} with a symlink"
        )

    link_path.symlink_to(expected_target)
    print(f"sync-skills: linked .agents/skills/{name} -> skills/{name}")
    return True


def load_installed_skills() -> set[str]:
    if not LOCK_PATH.exists():
        return set()

    data = json.loads(LOCK_PATH.read_text())
    skills = data.get("skills")
    if not isinstance(skills, dict):
        raise RuntimeError(f"invalid skill lock file: {LOCK_PATH}")
    return set(skills)


def move_installed_skill(name: str) -> bool:
    agent_path = AGENTS_SKILLS_DIR / name
    custom_path = SKILLS_DIR / name

    if agent_path.is_symlink():
        if not custom_path.is_dir() or custom_path.is_symlink():
            raise RuntimeError(
                f"installed skill {name} has no physical skills/{name} source"
            )
        if agent_path.resolve() != custom_path.resolve():
            raise RuntimeError(
                f"installed skill {name} points outside the canonical skill roots"
            )
        agent_path.unlink()
        custom_path.rename(agent_path)
        print(f"sync-skills: moved skills/{name} -> .agents/skills/{name}")
        return True

    if agent_path.is_dir():
        if path_exists(custom_path):
            raise RuntimeError(
                f"installed skill {name} exists physically in both skill roots"
            )
        return False

    if path_exists(agent_path):
        raise RuntimeError(f"installed skill {name} is not a directory")

    if custom_path.is_dir() and not custom_path.is_symlink():
        custom_path.rename(agent_path)
        print(f"sync-skills: moved skills/{name} -> .agents/skills/{name}")
        return True

    # A stale lock entry may have no corresponding directory.
    return False


def move_custom_skill(name: str) -> bool:
    agent_path = AGENTS_SKILLS_DIR / name
    custom_path = SKILLS_DIR / name

    if agent_path.is_symlink():
        return link_custom_skill(name)

    if not agent_path.is_dir():
        raise RuntimeError(f"custom skill {name} is not a directory")
    if path_exists(custom_path):
        raise RuntimeError(
            f"custom skill {name} exists physically in both skill roots"
        )

    agent_path.rename(custom_path)
    print(f"sync-skills: moved .agents/skills/{name} -> skills/{name}")
    link_custom_skill(name)
    return True


def link_cursor_skill(name: str) -> bool:
    source = SKILLS_DIR / name
    if not source.is_dir() or source.is_symlink():
        raise RuntimeError(
            f"cursor skill {name} has no physical skills/{name} source"
        )

    CURSOR_SKILLS_DIR.mkdir(parents=True, exist_ok=True)
    link_path = CURSOR_SKILLS_DIR / name
    expected_target = Path(os.path.relpath(source, CURSOR_SKILLS_DIR))

    if link_path.is_symlink():
        if Path(os.readlink(link_path)) == expected_target:
            return False
        link_path.unlink()
    elif link_path.exists():
        raise RuntimeError(
            f"refusing to replace physical ~/.cursor/skills/{name} with a symlink"
        )

    link_path.symlink_to(expected_target)
    print(f"sync-skills: linked ~/.cursor/skills/{name} -> skills/{name}")
    return True


def main() -> None:
    SKILLS_DIR.mkdir(parents=True, exist_ok=True)
    AGENTS_SKILLS_DIR.mkdir(parents=True, exist_ok=True)

    installed = load_installed_skills()
    changed = False

    for name in sorted(installed):
        changed = move_installed_skill(name) or changed

    for path in sorted(AGENTS_SKILLS_DIR.iterdir()):
        if path.name in installed:
            continue
        if path.is_symlink():
            custom_path = SKILLS_DIR / path.name
            if not custom_path.is_dir() or custom_path.is_symlink():
                path.unlink()
                print(f"sync-skills: removed stale custom link {path.name}")
                changed = True
            continue
        changed = move_custom_skill(path.name) or changed

    for path in sorted(SKILLS_DIR.iterdir()):
        if path.name in installed:
            raise RuntimeError(
                f"installed skill {path.name} remains in the custom skill root"
            )
        if path.is_symlink() or not path.is_dir():
            print(f"sync-skills: skipping non-directory skills/{path.name}")
            continue
        changed = link_custom_skill(path.name) or changed

    for name in CURSOR_SYNC_SKILLS:
        changed = link_cursor_skill(name) or changed

    if not changed:
        print("sync-skills: nothing to do")


if __name__ == "__main__":
    main()
