#!/usr/bin/env bash

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
export PATH="{{ .chezmoi.homeDir }}/.opencode/bin:{{ .chezmoi.homeDir }}/.local/share/mise/shims:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{- else -}}
export PATH="{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/bin:/usr/bin:/bin"
{{- end }}

MODEL_PROVIDER="claude-agent"
MODEL_ID="opus"
MODEL_VARIANT="xhigh"
AGENT="memory-dream"
MEMORY_DIR="${AGENT_MEMORY_DIR:-$HOME/agent-memory}"
STATE_DIR="$HOME/.local/state/agent-memory-dream"
STATE_FILE="$STATE_DIR/last-success-ms"
SESSION_FILE="$STATE_DIR/session-id"
MAX_SESSIONS=30
{{ if eq .chezmoi.os "darwin" -}}
LOG="$HOME/Library/Logs/agent-memory-dream.log"

notify_failure() {
	osascript -e 'on run argv' \
		-e 'display notification (item 1 of argv) with title "Agent memory dream failed"' \
		-e 'end run' -- "See $LOG" >/dev/null 2>&1 || true
}
{{- else -}}
LOG="journalctl --user -u agent-memory-dream"

notify_failure() {
	notify-send --app-name=OpenCode "Agent memory dream failed" "See $LOG" >/dev/null 2>&1 || true
}
{{- end }}
trap 'echo "failed at line $LINENO"; notify_failure' ERR

response=$(mktemp)
trap 'rm -f "$response"' EXIT

api() {
	opencode api "$@" >"$response"
	cat "$response"
}

echo "=== agent-memory-dream: $(date) ==="

mkdir -p "$STATE_DIR"
started_ms=$(($(date +%s) * 1000))
since_ms=$(cat "$STATE_FILE" 2>/dev/null || echo $((started_ms - 86400000)))

selected=$(api get "/api/session?parentID=null&order=desc&limit=200" |
	jq -c --argjson since "$since_ms" --argjson max "$MAX_SESSIONS" '
		[.data[]
			| select(.time.updated > $since)
			| select((.metadata // {}).agentMemoryDream != true)]
		| sort_by(.time.updated)
		| {backlog: (length > $max), sessions: .[:$max]}')

if [[ $(jq '.sessions | length' <<<"$selected") -eq 0 ]]; then
{{- if eq .chezmoi.os "darwin" }}
	echo "No sessions since $(date -r $((since_ms / 1000)))."
{{- else }}
	echo "No sessions since $(date -d @$((since_ms / 1000)))."
{{- end }}
	echo "$started_ms" >"$STATE_FILE"
	exit 0
fi

sessions=$(jq -r '.sessions[] | "- \(.id) | \(.title // "untitled") | \(.location.directory)"' <<<"$selected")
if [[ $(jq '.backlog' <<<"$selected") == "true" ]]; then
	next_since_ms=$(jq '.sessions[-1].time.updated' <<<"$selected")
else
	next_since_ms=$started_ms
fi

echo "--- sessions to review"
echo "$sessions"

model=$(jq -nc --arg provider "$MODEL_PROVIDER" --arg model "$MODEL_ID" --arg variant "$MODEL_VARIANT" \
	'{providerID: $provider, id: $model, variant: $variant}')
session_id=$(cat "$SESSION_FILE" 2>/dev/null || true)
if [[ -n "$session_id" ]] && opencode api get "/api/session/$session_id" >/dev/null 2>&1; then
	api post "/api/session/$session_id/agent" --data "$(jq -nc --arg agent "$AGENT" '{agent: $agent}')" >/dev/null
	api post "/api/session/$session_id/model" --data "$(jq -nc --argjson model "$model" '{model: $model}')" >/dev/null
	echo "--- dream session $session_id (reused)"
else
	body=$(jq -n \
		--arg dir "$MEMORY_DIR" \
		--arg agent "$AGENT" \
		--argjson model "$model" \
		'{title: "Nightly memory dream", agent: $agent, model: $model,
		  location: {directory: $dir}, metadata: {agentMemoryDream: true}}')
	session_id=$(api post /api/session --data "$body" | jq -er '.data.id')
	echo "$session_id" >"$SESSION_FILE"
	echo "--- dream session $session_id (new)"
fi

api post "/api/session/$session_id/command" \
	--data "$(jq -n --arg text "$sessions" '{name: "dream", text: $text}')" >/dev/null
api post "/api/experimental/session/$session_id/wait" --data '{}' >/dev/null

messages=$(api get "/api/session/$session_id/message")
outcome=$(jq -r '[.data[] | select(.type == "idle")][0].outcome // "unknown"' <<<"$messages")
echo "--- outcome: $outcome"
jq -r '[.data[] | select(.type == "assistant")][0].content[]? | select(.type == "text") | .text' <<<"$messages"

if [[ "$outcome" != "succeeded" ]]; then
	notify_failure
	exit 1
fi

echo "$next_since_ms" >"$STATE_FILE"
git -C "$MEMORY_DIR" status -sb

if opencode api post "/api/session/$session_id/compact" --data '{}' >/dev/null &&
	opencode api post "/api/experimental/session/$session_id/wait" --data '{}' >/dev/null; then
	echo "--- compacted dream session"
else
	echo "--- compaction failed; the next run reuses the session uncompacted"
fi
