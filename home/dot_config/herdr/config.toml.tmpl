onboarding = false


[theme]
name = "terminal"

[theme.custom]
panel_bg = "#0a0a0a"
sidebar_bg = "#0a0a0a"
active_row_bg = "#242424"
selection_bg = "#242424"
surface0 = "#161616"
surface1 = "#242424"
surface_dim = "#161616"
overlay0 = "#3a3a3a"
overlay1 = "#5c5c5c"
text = "#eeeeee"
subtext0 = "#808080"
accent = "#EC5B2B"
mauve = "#EE7948"
green = "#6ba1e6"
yellow = "#e5c07b"
red = "#e06c75"
blue = "#6ba1e6"
teal = "#56b6c2"
peach = "#EE7948"

[terminal]


new_cwd = "follow"

[update]

[keys]
prefix = "ctrl+a"

reload_config = "prefix+r"
workspace_picker = "prefix+w"
new_tab = "prefix+c"
previous_tab = "prefix+p"
next_tab = "prefix+n"
switch_tab = "prefix+1..9"
focus_pane_left = "ctrl+h"
focus_pane_down = "ctrl+j"
focus_pane_up = "ctrl+k"
focus_pane_right = "ctrl+l"
split_vertical = "prefix+backslash"
split_horizontal = "prefix+minus"
close_pane = "prefix+x"
zoom = "prefix+m"
resize_mode = "prefix+shift+r"

navigate_workspace_up = "k"
navigate_workspace_down = "j"
navigate_pane_down = "down"
navigate_pane_up = "up"


[[keys.command]]
key = "prefix+f"
type = "pane"
command = "{{ .chezmoi.homeDir }}/.local/bin/herdr-sessionizer"
description = "workspace picker (fzf)"

[ui]
sidebar_width = 36

sidebar_min_width = 30

sidebar_max_width = 80

sidebar_start_collapsed = false

agent_panel_sort = "spaces"
show_agent_labels_on_pane_borders = true

status_indicators = "symbols"
[ui.toast]

delivery = "system"
[ui.sound]


[session]

[remote]

[experimental]
kitty_graphics = true
pane_history = true

switch_ascii_input_source_in_prefix = true
[advanced]

[[keys.command]]
key = "prefix+shift+h"
type = "plugin_action"
command = "jhochenbaum.hunkdiff.review"
description = "hunk: review changes"

[[keys.command]]
key = "prefix+shift+s"
type = "plugin_action"
command = "jhochenbaum.hunkdiff.send-review"
description = "hunk: send review to agent"

[[keys.command]]
key = "prefix+shift+c"
type = "plugin_action"
command = "jhochenbaum.hunkdiff.review:commit"
description = "hunk: review the last commit"

[[keys.command]]
key = "prefix+shift+a"
type = "plugin_action"
command = "jhochenbaum.hunkdiff.review:staged"
description = "hunk: review staged changes"
