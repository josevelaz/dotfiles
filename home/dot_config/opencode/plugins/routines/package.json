{
  "name": "local-routines",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./rpc": "./rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --lib ES2022,DOM --types node index.ts tick.ts && tsc -p tsconfig.gui.json",
    "tick": "bun tick.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0",
    "croner": "11.0.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "typescript": "5.8.2",
    "solid-js": "1.9.17",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  }
}
