  "components": [
    {
      "name": "Avatar",
      "group": "Identity",
      "summary": "Initials written in ink inside an ink outline on fresh paper."
    },
    {
      "name": "BookServiceScreen",
      "group": "Screens",
      "summary": "Client · Book · service."
    },
    {
      "name": "BookedScreen",
      "group": "Screens",
      "summary": "Client · Booked."
    },
    {
      "name": "BookingPicker",
      "group": "Patterns",
      "summary": "The client's booking step: a week strip, the open start times for the chosen day, the place, and a summary."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Buttons are pressable paper labels: a solid fill, a 1.5px ink edge and a 2px ink edge underneath."
    },
    {
      "name": "CalendarScreen",
      "group": "Screens",
      "summary": "Trainer · Calendar."
    },
    {
      "name": "Card",
      "group": "Containers",
      "summary": "A card is a sheet of paper on the page: surface with a hairline border and 10px corners, flat."
    },
    {
      "name": "Checkout",
      "group": "Patterns",
      "summary": "Pay a booking deposit without an account."
    },
    {
      "name": "ClientHomeScreen",
      "group": "Screens",
      "summary": "Client · Home."
    },
    {
      "name": "ClientProfile",
      "group": "Patterns",
      "summary": "Everything about one client and their dog."
    },
    {
      "name": "ClientsScreen",
      "group": "Screens",
      "summary": "Trainer · Clients."
    },
    {
      "name": "DateTimePicker",
      "group": "Inputs",
      "summary": "Pick a day, then a start time."
    },
    {
      "name": "EmptyState",
      "group": "Feedback",
      "summary": "Say why a place is empty and what to do next: a small landscape or paper sketch, a short Fraunces title, one sentence, at most one button."
    },
    {
      "name": "HomeworkCard",
      "group": "Patterns",
      "summary": "What the client practises between sessions."
    },
    {
      "name": "Icons",
      "group": "Foundations",
      "summary": "A small, purpose-drawn line set: 24px grid, 1.75px stroke, round caps and joins, no fills, coloured with currentColor."
    },
    {
      "name": "InboxScreen",
      "group": "Screens",
      "summary": "Trainer · Inbox."
    },
    {
      "name": "Input",
      "group": "Inputs",
      "summary": "Fields are fresh paper (surface-raised) with a border-strong edge, 8px corners and a visible label above."
    },
    {
      "name": "Invoice",
      "group": "Patterns",
      "summary": "An invoice is a receipt: who it's from, who it's billed to, line items, and a double ink rule above the balance."
    },
    {
      "name": "ListRow",
      "group": "Containers",
      "summary": "Lists are written on the page, not boxed: a 1.5px ink ledger rule (ink-rule) across the top, a slightly uneven pen line (rule) between items, a hairline at the…"
    },
    {
      "name": "MoneyScreen",
      "group": "Screens",
      "summary": "Trainer · Money."
    },
    {
      "name": "PayScreen",
      "group": "Screens",
      "summary": "Client · Pay."
    },
    {
      "name": "PenMarks",
      "group": "Foundations",
      "summary": "Pen marks are the trainer's hand on the page: a clay circle or squiggle drawn over the UI to say \"this one\"."
    },
    {
      "name": "Segmented",
      "group": "Containers",
      "summary": "Two to four mutually exclusive choices in one paper label: an ink edge and under-edge around the whole control, ink lines between segments, and the chosen segm…"
    },
    {
      "name": "Select",
      "group": "Inputs",
      "summary": "Choose one thing from a known list."
    },
    {
      "name": "SessionNote",
      "group": "Patterns",
      "summary": "After a session Herder drafts the client note from Maya's voice memo."
    },
    {
      "name": "Sheet",
      "group": "Containers",
      "summary": "Bottom sheets and modals put one short task or decision on top of the screen, on fresh paper (surface-raised) over a scrim."
    },
    {
      "name": "SignedScreen",
      "group": "Screens",
      "summary": "Client · Waiver signed."
    },
    {
      "name": "SmsThread",
      "group": "Patterns",
      "summary": "One text conversation with a client, as their phone shows it, plus what Herder did and what it suggests."
    },
    {
      "name": "Stamp",
      "group": "Feedback",
      "summary": "Stamps say the status of a thing in a word or two, like a rubber stamp: an ink outline, no fill, a slightly worn ink texture."
    },
    {
      "name": "StickyNote",
      "group": "Paper",
      "summary": "A sticky note is stuck on the page, not written in it."
    },
    {
      "name": "Tabs",
      "group": "Containers",
      "summary": "Two kinds, each with one job, and both marked in pen because they show where you are."
    },
    {
      "name": "Toast",
      "group": "Feedback",
      "summary": "Toasts confirm what just happened; banners explain a lasting condition in place."
    },
    {
      "name": "TodayScreen",
      "group": "Screens",
      "summary": "Trainer · Today."
    },
    {
      "name": "WaiverSigning",
      "group": "Patterns",
      "summary": "The client reads the waiver, agrees and signs."
    }
  ],
