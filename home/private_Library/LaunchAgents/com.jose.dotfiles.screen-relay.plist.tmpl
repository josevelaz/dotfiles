<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jose.dotfiles.screen-relay</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/share/screen-relay/engine/{{ .screen_relay.version }}/relay-engine</string>
		<string>--backend</string>
		<string>macos</string>
		<string>--bind</string>
		<string>{{ .screen_relay.bind }}</string>
		<string>--port</string>
		<string>{{ .screen_relay.port }}</string>
		<string>--viewer-dir</string>
		<string>{{ .chezmoi.homeDir }}/.local/share/screen-relay/viewer/{{ .screen_relay.version }}</string>
		<string>--token-file</string>
		<string>{{ .chezmoi.homeDir }}/.local/state/screen-relay/token</string>
		<string>--public-origin</string>
		<string>https://{{ .screen_relay.host }}:{{ .screen_relay.port }}</string>
		<string>--tls-cert</string>
		<string>{{ .chezmoi.homeDir }}/.local/share/screen-relay/tls/cert.pem</string>
		<string>--tls-key</string>
		<string>{{ .chezmoi.homeDir }}/.local/share/screen-relay/tls/key.pem</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/screen-relay.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/screen-relay.log</string>
</dict>
</plist>
