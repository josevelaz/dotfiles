<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jose.dotfiles.sync-skills</string>

	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/bin/sync-skills</string>
	</array>
	<key>WatchPaths</key>
	<array>
		<string>{{ .chezmoi.workingTree }}/skills</string>
		<string>{{ .chezmoi.workingTree }}/.agents/skills</string>
		<string>{{ .chezmoi.workingTree }}/.agents/.skill-lock.json</string>
		<string>{{ .chezmoi.homeDir }}/.cursor/skills</string>
	</array>
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/dotfiles-sync-skills.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/dotfiles-sync-skills.log</string>
</dict>
</plist>
