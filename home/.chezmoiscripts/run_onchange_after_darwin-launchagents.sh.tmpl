{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
{{ range (glob (joinPath .chezmoi.sourceDir "private_Library/LaunchAgents/*.plist.tmpl")) -}}
# {{ base . }} {{ include . | sha256sum }}
{{ end -}}
set -euo pipefail
domain="gui/$(id -u)"

for plist in "$HOME"/Library/LaunchAgents/com.jose.dotfiles.*.plist; do
	label=$(basename "$plist" .plist)
	launchctl bootout "$domain/$label" 2>/dev/null || true
	if launchctl print-disabled "$domain" | grep -q "\"$label\" => disabled"; then
		echo "chezmoi: $label is disabled in launchd; left unloaded" >&2
		continue
	fi
	launchctl bootstrap "$domain" "$plist"
done
{{ end -}}
