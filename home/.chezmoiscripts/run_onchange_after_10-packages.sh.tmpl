#!/bin/bash
{{ if eq .chezmoi.os "darwin" -}}
# {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
{{- else -}}
# {{ include "dot_config/packages/arch.txt" | sha256sum }} {{ include "dot_config/packages/ubuntu.txt" | sha256sum }}
{{- end }}
set -euo pipefail
helper="$HOME/.local/bin/dotfiles-packages"
{{ if eq .chezmoi.os "darwin" -}}
if ! "$helper"; then
	echo "chezmoi: brew bundle could not finish; run dotfiles-packages in a terminal" >&2
	osascript -e 'display notification "Run dotfiles-packages in a terminal to finish installing." with title "Packages need you"' || true
fi
{{- else -}}
if ! missing=$("$helper" --check); then
	echo "chezmoi: packages missing ($missing); run dotfiles-packages" >&2
	if command -v notify-send >/dev/null; then
		notify-send --app-name=dotfiles "Packages missing" "Run dotfiles-packages to install: $missing" || true
	fi
fi
{{- end }}
