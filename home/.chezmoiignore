# Target paths chezmoi leaves alone. Repository-only files live outside home/
# (see .chezmoiroot), so they never reach a machine.

{{- if ne .chezmoi.os "darwin" }}

# macOS-only software and its state
.config/aegis
.config/karabiner
.config/omniwm
.config/raycast
.config/sketchybar
.config/skhd
.config/yabai
.config/yabai-backup-2026-10-17
.config/agentfs/agentfs-receipt.json
Library
mutagen.yml
.local/bin/brew-upgrade-morning
.local/bin/codexbar-omniwm-sync
.local/bin/ghostty-init.sh
.local/bin/push-dotfile-changes.sh
.config/nvim/lua/plugins/orng-theme.lua

# Skills that drive macOS apps (and the harness links to them)
.agents/skills/agent-desktop
.agents/skills/rex
.agents/skills/tldraw-offline
.config/*/skills/agent-desktop
.config/*/skills/rex
.config/*/skills/tldraw-offline
.pi/agent/skills/tldraw-offline
{{- end }}

{{- if ne .chezmoi.os "linux" }}

# systemd user units (macOS uses the LaunchAgents above)
.config/systemd
{{- end }}
