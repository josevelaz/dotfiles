.DS_store

.pi/agent/sessions/
.pi/agent/auth.json

.zsh_secrets.sh
.config/github-copilot/
.config/github-copilot/apps.json
.config/.wrangler/
.claude/

# Machine-local zsh overrides (copy from .config/zsh/local.example.zsh)
.config/zsh/local.zsh

.local/share/
.local/state/
.local/lib/

.zsh_secrets

# Hermes: secrets, runtime state, caches, logs, and generated installs
.hermes/
.hermes/.env
.hermes/auth.json
.hermes/*.lock
.hermes/*.db
.hermes/*.db-*
.hermes/*.sqlite
.hermes/*.sqlite-*
.hermes/.hermes_history
.hermes/.skills_prompt_snapshot.json
.hermes/.update_check
.hermes/config.yaml.bak.*
.hermes/cache/
.hermes/logs/
.hermes/pastes/
.hermes/sessions/
.hermes/state-snapshots/
.hermes/*_cache.json
.hermes/*_cache.yaml
.hermes/honcho.json
.hermes/bin/
.hermes/hermes-agent/
.hermes/plugins/*/state.json
.hermes/plugins/*/scan_*.json

# Hermes per-profile runtime/secrets
.hermes/profiles/*/.env
.hermes/profiles/*/*.db
.hermes/profiles/*/*.db-*
.hermes/profiles/*/*.sqlite
.hermes/profiles/*/*.sqlite-*
.hermes/profiles/*/logs/
.hermes/profiles/*/sessions/
.hermes/profiles/
.hermes/mcp-tokens/
.hermes/skills/
.hermes/config.yaml
.hermes/SOUL.md
.hermes/dashboard-themes/

# Agent/runtime credentials and generated installs
.config/context7/credentials.json
.config/raycast/config.json
.config/raycast-x/
.config/sleev/
.config/cf/
.config/op/
.honcho/
.pi/agent/npm/

# Runtime session state and logs
.weave/
.config/opencode/.weave/runtime/
.config/herdr/*.log
.config/herdr/session*.json
.config/herdr/sessions/
.config/herdr/release-notes.json
.config/herdr-dev/
.local/bin/cua-driver
.local/bin/herdr
.local/bin/ocx
.local/bin/python3.11
.local/bin/sleev

# Pi bash-audit extension: the extension writes no files, but an older loaded
# copy in a running Pi process can still recreate this cache. Never commit it.
.pi/agent/bash-audit-cache.json
# Dev-only type-check install for Pi extensions (bun install; never committed)
.pi/agent/extensions/*/node_modules/

# Credentials, OAuth dumps, and crash reports. Purged from history; do not force-add.
.config/opencode/service.json
.config/google-chrome-for-testing/
.config/go/telemetry/

# Generated installs, caches, logs, and machine-local agent state
.pi/agent/local/
.pi/agent/npm/
.pi/agent/pi-fff/
.pi/agent/bin/
.pi/agent/tmp/
.pi/agent/*.log
.pi/agent/git/
.pi/agent/models.json
.pi/agent/models-store.json
.pi/agent/insights.json
.pi/agent/pi-codex-compaction.json
.pi/cache/
.pi/.lavish/
.pi/insights/
.config/raycast/node-compile-cache/
.config/herdr/plugins/
.config/herdr/.plugins.lock
.config/herdr/*.hunkdiff-backup
.config/browser-harness/
.config/firekeeper/
.config/hunk/state.json
.config/btw
.pi/agent/intercom/
.zshrc.bak.*
.local/bin/herdr.backup-*
.local/bin/python3.13
.local/bin/codex
.local/bin/codex-code-mode-host
.local/bin/btw
.local/bin/rtk
