{
  // VSCodeVim Configuration
  "vim.leader": " ",
  "vim.enableNeovim": false,
  "vim.useSystemClipboard": false,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 250,
  
  // Cursor configuration for different vim modes
  "vim.cursorStylePerMode": {
    "normal": "block",
    "insert": "block",
    "visual": "block"
  },
  
  // Handle keys - delegate some keys back to VS Code except window navigation
  "vim.handleKeys": {
    "<C-f>": false,
    "<C-w>": false
  },
  
  // Normal mode key bindings (non-recursive)
  "vim.normalModeKeyBindingsNonRecursive": [
    // =====================================
    // WINDOW MANAGEMENT
    // =====================================
    
    // Window navigation (Ctrl+h/j/k/l) - Fixed approach
    
    // Ctrl+h - Navigate left or to sidebar
    {
      "before": ["<C-h>"],
      "commands": ["workbench.action.focusSideBar"],
      "when": "vim.active && vim.mode == 'Normal' && editorTextFocus"
    },
    {
      "before": ["<C-h>"], 
      "commands": ["workbench.action.focusLeftGroup"],
      "when": "vim.active && vim.mode == 'Normal' && editorTextFocus && sideBarVisible"
    },
    
    // Ctrl+l - Navigate right  
    {
      "before": ["<C-l>"],
      "commands": ["workbench.action.focusRightGroup"],
      "when": "vim.active && vim.mode == 'Normal' && editorTextFocus"
    },
    
    // Ctrl+k - Navigate up
    {
      "before": ["<C-k>"],
      "commands": ["workbench.action.focusAboveGroup"], 
      "when": "vim.active && vim.mode == 'Normal' && editorTextFocus"
    },
    
    // Ctrl+j - Navigate down or to panel
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.focusPanel"],
      "when": "vim.active && vim.mode == 'Normal' && editorTextFocus"
    },
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.focusBelowGroup"],
      "when": "vim.active && vim.mode == 'Normal' && editorTextFocus && !panelVisible"
    },
    
    // Window splitting
    {
      "before": ["<C-w>", "v"],
      "commands": ["workbench.action.splitEditor"]
    },
    {
      "before": ["<C-w>", "s"],
      "commands": ["workbench.action.splitEditorDown"]
    },
    {
      "before": ["<C-w>", "c"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<C-w>", "o"],
      "commands": ["workbench.action.closeOtherEditors"]
    },
    
    // Window resizing
    {
      "before": ["<C-w>", ">"],
      "commands": ["workbench.action.increaseViewWidth"]
    },
    {
      "before": ["<C-w>", "<"],
      "commands": ["workbench.action.decreaseViewWidth"]
    },
    {
      "before": ["<C-w>", "+"],
      "commands": ["workbench.action.increaseViewHeight"]
    },
    {
      "before": ["<C-w>", "-"],
      "commands": ["workbench.action.decreaseViewHeight"]
    },
    {
      "before": ["<C-w>", "="],
      "commands": ["workbench.action.evenEditorWidths"]
    },
    
    // =====================================
    // LSP NAVIGATION & ACTIONS
    // =====================================
    
    // Go to definition
    {
      "before": ["g", "d"],
      "commands": ["editor.action.revealDefinition"]
    },
    
    // Go to references
    {
      "before": ["g", "r"],
      "commands": ["editor.action.goToReferences"]
    },
    
    // Go to implementation
    {
      "before": ["g", "I"],
      "commands": ["editor.action.goToImplementation"]
    },
    
    // Go to declaration
    {
      "before": ["g", "D"],
      "commands": ["editor.action.revealDeclaration"]
    },
    
    // Hover documentation
    {
      "before": ["K"],
      "commands": ["editor.action.showHover"]
    },
    
    // Type definition
    {
      "before": ["<leader>", "D"],
      "commands": ["editor.action.goToTypeDefinition"]
    },
    
    // Document symbols
    {
      "before": ["<leader>", "d", "s"],
      "commands": ["workbench.action.gotoSymbol"]
    },
    
    // Workspace symbols
    {
      "before": ["<leader>", "w", "s"],
      "commands": ["workbench.action.showAllSymbols"]
    },
    
    // Rename
    {
      "before": ["<leader>", "r", "n"],
      "commands": ["editor.action.rename"]
    },
    
    // Code actions
    {
      "before": ["<leader>", "c", "a"],
      "commands": ["editor.action.quickFix"]
    },
    
    // Toggle inlay hints
    {
      "before": ["<leader>", "c", "i"],
      "commands": ["editor.action.toggleInlayHints"]
    },
    
    // =====================================
    // VIM MOTIONS & NAVIGATION
    // =====================================
    
    // Page navigation with centering
    {
      "before": ["<C-d>"],
      "after": ["<C-d>", "z", "z"]
    },
    {
      "before": ["<C-u>"],
      "after": ["<C-u>", "z", "z"]
    },
    
    // Search navigation with centering
    {
      "before": ["n"],
      "after": ["n", "z", "z", "z", "v"]
    },
    {
      "before": ["N"],
      "after": ["N", "z", "z", "z", "v"]
    },
    
    // Join lines without moving cursor
    {
      "before": ["J"],
      "after": ["m", "z", "J", "`", "z"]
    },
    
    // Navigate quickfix/errors
    {
      "before": ["<M-n>"],
      "commands": ["editor.action.marker.next"]
    },
    {
      "before": ["<M-p>"],
      "commands": ["editor.action.marker.prev"]
    },
    
    // Disable Q
    {
      "before": ["Q"],
      "after": ["<nop>"]
    },
    
    // =====================================
    // LEADER KEY BINDINGS
    // =====================================
    
    // Quick save
    {
      "before": ["<leader>", "<leader>"],
      "commands": ["workbench.action.files.save"]
    },
    
    // Buffer navigation
    {
      "before": ["<leader>", "l"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<leader>", "h"],
      "commands": ["workbench.action.previousEditor"]
    },
    
    // Close buffer/tab
    {
      "before": ["<leader>", "b", "d"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    
    // Quit application
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.quit"]
    },
    
    // Search and replace
    {
      "before": ["<leader>", "r", "s"],
      "commands": ["editor.action.startFindReplaceAction"]
    },
    
    // File explorer
    {
      "before": ["<leader>", "p", "v"],
      "commands": ["workbench.view.explorer"]
    },
    
    // Open diagnostic float (problems panel)
    {
      "before": ["<leader>", "k"],
      "commands": ["workbench.actions.view.problems"]
    },
    
    // Format document
    {
      "before": ["<leader>", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    
    // Git diff view (source control)
    {
      "before": ["<leader>", "d", "v", "o"],
      "commands": ["workbench.view.scm"]
    },
    
    // =====================================
    // SNACKS.LUA PICKER KEYBINDINGS
    // =====================================
    
    // Search help
    {
      "before": ["<leader>", "s", "h"],
      "commands": ["workbench.action.showCommands"]
    },
    
    // Search keymaps
    {
      "before": ["<leader>", "s", "k"],
      "commands": ["workbench.action.openGlobalKeybindings"]
    },
    
    // Search files
    {
      "before": ["<leader>", "s", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    
    // Search LSP symbols
    {
      "before": ["<leader>", "s", "y"],
      "commands": ["workbench.action.gotoSymbol"]
    },
    
    // Search select (command palette)
    {
      "before": ["<leader>", "s", "s"],
      "commands": ["workbench.action.showCommands"]
    },
    
    // Search current word
    {
      "before": ["<leader>", "s", "w"],
      "commands": ["editor.action.addSelectionToNextFindMatch"]
    },
    
    // Search by grep
    {
      "before": ["<leader>", "s", "g"],
      "commands": ["workbench.action.findInFiles"]
    },
    
    // Search diagnostics
    {
      "before": ["<leader>", "s", "d"],
      "commands": ["workbench.actions.view.problems"]
    },
    
    // Search resume (recent searches)
    {
      "before": ["<leader>", "s", "r"],
      "commands": ["workbench.action.findInFiles"]
    },
    
    // Search recent files
    {
      "before": ["<leader>", "s", "."],
      "commands": ["workbench.action.openRecent"]
    },
    
    // Find existing buffers
    {
      "before": ["<leader>", "f", "b"],
      "commands": ["workbench.action.showAllEditors"]
    },
    
    // Search in current buffer
    {
      "before": ["<leader>", "/"],
      "commands": ["actions.find"]
    },
    
    // Search in open files
    {
      "before": ["<leader>", "s", "/"],
      "commands": ["workbench.action.findInFiles"]
    },
    
    // Search Neovim files (settings)
    {
      "before": ["<leader>", "s", "n"],
      "commands": ["workbench.action.openSettings"]
    },
    
    // =====================================
    // MOUSE-FREE NAVIGATION ADDITIONS
    // =====================================
    
    // Toggle sidebar visibility
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    
    // Toggle panel visibility (terminal/problems)
    {
      "before": ["<leader>", "t"],
      "commands": ["workbench.action.togglePanel"]
    },
    
    // Focus terminal specifically
    {
      "before": ["<leader>", "T"],
      "commands": ["workbench.action.terminal.focus"]
    },
    
    // Close panel/sidebar when focused
    {
      "before": ["<Esc>"],
      "commands": ["workbench.action.focusActiveEditorGroup"],
      "when": "sideBarFocus"
    },
    {
      "before": ["<Esc>"],
      "commands": ["workbench.action.focusActiveEditorGroup"], 
      "when": "panelFocus"
    },
    {
      "before": ["<Esc>"],
      "commands": ["workbench.action.focusActiveEditorGroup"],
      "when": "terminalFocus"
    },
    
    // Tab navigation
    {
      "before": ["g", "t"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["g", "T"],
      "commands": ["workbench.action.previousEditor"]
    },
    
    // Close current tab
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    
    // Reopen closed tab
    {
      "before": ["<leader>", "u"],
      "commands": ["workbench.action.reopenClosedEditor"]
    },
    
    // Focus first/last tab
    {
      "before": ["<leader>", "1"],
      "commands": ["workbench.action.openEditorAtIndex1"]
    },
    {
      "before": ["<leader>", "2"],
      "commands": ["workbench.action.openEditorAtIndex2"]
    },
    {
      "before": ["<leader>", "3"],
      "commands": ["workbench.action.openEditorAtIndex3"]
    },
    {
      "before": ["<leader>", "4"],
      "commands": ["workbench.action.openEditorAtIndex4"]
    },
    {
      "before": ["<leader>", "5"],
      "commands": ["workbench.action.openEditorAtIndex5"]
    },
    {
      "before": ["<leader>", "0"],
      "commands": ["workbench.action.lastEditorInGroup"]
    },
    
    // Navigate within file explorer when focused
    {
      "before": ["<CR>"],
      "commands": ["list.select"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    {
      "before": ["o"],
      "commands": ["list.select"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    {
      "before": ["<BS>"],
      "commands": ["list.collapse"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    
    // File operations in explorer
    {
      "before": ["a"],
      "commands": ["explorer.newFile"],
      "when": "sideBarFocus && explorerViewletFocus && !editorTextFocus"
    },
    {
      "before": ["A"],
      "commands": ["explorer.newFolder"], 
      "when": "sideBarFocus && explorerViewletFocus"
    },
    {
      "before": ["r"],
      "commands": ["renameFile"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    {
      "before": ["d"],
      "commands": ["deleteFile"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    {
      "before": ["x"],
      "commands": ["filesExplorer.cut"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    {
      "before": ["y"],
      "commands": ["filesExplorer.copy"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    {
      "before": ["p"],
      "commands": ["filesExplorer.paste"],
      "when": "sideBarFocus && explorerViewletFocus"
    },
    
    // Zen mode and distraction-free editing
    {
      "before": ["<leader>", "z"],
      "commands": ["workbench.action.toggleZenMode"]
    },
    
    // Focus breadcrumbs for navigation
    {
      "before": ["<leader>", "b"],
      "commands": ["breadcrumbs.focus"]
    },
    
    // Navigate through problems/diagnostics
    {
      "before": ["]", "d"],
      "commands": ["editor.action.marker.nextInFiles"]
    },
    {
      "before": ["[", "d"],
      "commands": ["editor.action.marker.prevInFiles"]
    },
    
    // Git operations
    {
      "before": ["<leader>", "g", "s"],
      "commands": ["workbench.view.scm"]
    },
    {
      "before": ["<leader>", "g", "d"],
      "commands": ["git.openChange"]
    },
    {
      "before": ["<leader>", "g", "b"],
      "commands": ["gitlens.toggleFileBlame"]
    }
  ],
  
  // Visual mode key bindings
  "vim.visualModeKeyBindings": [
    // Move selected lines up/down
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"]
    }
  ],
  
  // Visual mode key bindings (non-recursive)
  "vim.visualModeKeyBindingsNonRecursive": [
    // Copy to system clipboard
    {
      "before": ["<leader>", "y"],
      "after": ["\"+", "y"]
    },
    // Delete to void register and paste
    {
      "before": ["<leader>", "p"],
      "after": ["\"", "_", "d", "P"]
    },
    // Delete to void register
    {
      "before": ["<leader>", "d"],
      "after": ["\"", "_", "d"]
    }
  ],
  
  // Insert mode key bindings
  "vim.insertModeKeyBindings": [
    // Arrow key navigation in insert mode
    {
      "before": ["<C-h>"],
      "after": ["<Left>"]
    },
    {
      "before": ["<C-l>"],
      "after": ["<Right>"]
    },
    // Exit insert mode with Ctrl+C
    {
      "before": ["<C-c>"],
      "after": ["<Esc>"]
    }
  ]
}
