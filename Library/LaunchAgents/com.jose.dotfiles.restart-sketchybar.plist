<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jose.dotfiles.restart-sketchybar</string>

	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/brew</string>
		<string>services</string>
		<string>restart</string>
		<string>sketchybar</string>
	</array>

	<!-- Fire at 08:00 local time every day. If the machine is asleep,
	     launchd runs the job as soon as it wakes. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/jose/Library/Logs/dotfiles-restart-sketchybar.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jose/Library/Logs/dotfiles-restart-sketchybar.log</string>
</dict>
</plist>
