<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jose.dotfiles.sync-skills</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/jose/dotfiles/.local/bin/sync-skills</string>
	</array>

	<!-- Watch both skill roots, the skills.sh lock file, and the Cursor links. -->
	<key>WatchPaths</key>
	<array>
		<string>/Users/jose/dotfiles/skills</string>
		<string>/Users/jose/dotfiles/.agents/skills</string>
		<string>/Users/jose/dotfiles/.agents/.skill-lock.json</string>
		<string>/Users/jose/.cursor/skills</string>
	</array>

	<!-- Also run once when the agent loads, to catch anything created
	     while the agent wasn't running. -->
	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/jose/Library/Logs/dotfiles-sync-skills.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/jose/Library/Logs/dotfiles-sync-skills.log</string>
</dict>
</plist>
